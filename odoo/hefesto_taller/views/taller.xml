<odoo>
<record id="order_list" model="ir.ui.view"><field name="name">hefesto.order.list</field><field name="model">hefesto.taller.order</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="device"/><field name="stage"/><field name="cancelled"/><field name="technician"/><field name="due"/><field name="total"/><field name="paid"/></list></field></record>
<record id="order_form" model="ir.ui.view"><field name="name">hefesto.order.form</field><field name="model">hefesto.taller.order</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="source_id"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id" invisible="1"/><field name="partner_id"/><field name="device"/><field name="serial"/><field name="stage"/><field name="cancelled"/><field name="technician"/><field name="due"/></group><notebook><page string="Diagnóstico"><field name="issue"/><field name="diagnosis"/></page><page string="Presupuesto"><field name="line_ids"><list editable="bottom"><field name="name"/><field name="quantity"/><field name="price"/></list></field><group><field name="total"/><field name="paid"/></group></page><page string="Pagos históricos"><p>No son asientos contables ni comprobantes bancarios.</p><field name="payment_ids" readonly="1"><list><field name="date_text"/><field name="method"/><field name="amount"/></list></field></page><page string="Registro original" groups="base.group_system"><field name="source_json"/></page></notebook></sheet></form></field></record>
<record id="import_form" model="ir.ui.view"><field name="name">hefesto.import.form</field><field name="model">hefesto.taller.import</field><field name="arch" type="xml"><form string="Importar Hefesto"><group><field name="filename" invisible="1"/><field name="payload" filename="filename"/><field name="dry_run"/><field name="update_existing"/><field name="report"/></group><footer><button name="action_import" type="object" string="Validar / importar" class="btn-primary"/><button string="Cerrar" special="cancel"/></footer></form></field></record>
<record id="order_action" model="ir.actions.act_window"><field name="name">Órdenes Hefesto</field><field name="res_model">hefesto.taller.order</field><field name="view_mode">list,form</field></record>
<record id="import_action" model="ir.actions.act_window"><field name="name">Importar respaldo</field><field name="res_model">hefesto.taller.import</field><field name="view_mode">form</field><field name="target">new</field></record>
<menuitem id="hefesto_root" name="Hefesto Taller" sequence="25"/>
<menuitem id="hefesto_orders" name="Órdenes" parent="hefesto_root" action="order_action" sequence="10"/>
<menuitem id="hefesto_import" name="Importar respaldo" parent="hefesto_root" action="import_action" groups="base.group_system" sequence="20"/>
</odoo>
